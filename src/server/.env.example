# Copy to .env and fill in. Never commit real values.

# PostgreSQL with PostGIS.
DATABASE_URL=postgres://localhost:5432/legacytracker
PORT=3000

# Optional: Firebase service account JSON for live-mode pushes.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Legacy Auth verification (defaults match production).
AUTH_JWKS_URI=https://auth.legacy-group.tech/.well-known/jwks.json
AUTH_ISSUER=https://auth.legacy-group.tech
AUTH_ALLOWED_CLIENTS=tracker-spa,tracker-mobile
AUTH_MOBILE_CLIENT=tracker-mobile

# Comma-separated browser origins; empty reflects any origin.
CORS_ALLOWED_ORIGINS=

# Networks whose X-Forwarded-For entries are believed, i.e. Fastify's
# trustProxy: it decides what request.ip is. The built-in default is
# Cloudflare's published ranges plus loopback and the private networks an
# in-network proxy reaches us from, which matches production
# (Cloudflare -> Traefik -> container). Override it if the chain changes.
# Only API token address allowlists act on the resolved client address.
# TRUSTED_PROXY_CIDRS=loopback,uniquelocal,173.245.48.0/20,104.16.0.0/13,...

# Mapbox: secret token with tokens:write, styles:read and fonts:read.
# Server-side only. It is used to mint short-lived tokens for the phone app;
# never expose it to a client, log it, or commit it.
MAPBOX_SECRET_TOKEN=
MAPBOX_USERNAME=
# Lifetime of minted temporary tokens in seconds (60–3600, default 3300).
MAPBOX_TOKEN_TTL_SECONDS=3300
