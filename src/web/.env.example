# Copy to .env.local for local development. Never commit real values.

# Production services unless overridden.
VITE_BACKEND_URL=https://tracker.legacy-group.tech
VITE_AUTH_URL=https://auth.legacy-group.tech
VITE_CALENDAR_URL=https://calendar.legacy-group.tech
VITE_CALENDAR_WEB_URL=https://legacy-calendar.pages.dev

# Mapbox public token (pk.*) restricted to the app's origins, including
# http://localhost:5173 for development. The production build fails without it.
VITE_MAPBOX_TOKEN=
